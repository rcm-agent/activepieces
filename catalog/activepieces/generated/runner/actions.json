  {
    "piece": "@activepieces/piece-slack",
    "version": "0.21.1",
    "action": "send_channel_message",
    "id": "send_channel_message",
    "display_name": "Send Message To A Channel",
    "description": "Send message to a channel",
    "auth_kinds": [
      "OAUTH2",
      "CUSTOM_AUTH"
    ],
    "props": {
      "info": {
        "type": "MARKDOWN",
        "required": false,
        "description": "The list shows the first 2000 channels. Can't find yours? Invite the bot: type **/invite** in the channel, choose **Add apps** and pick the bot. Or click **ƒ** and paste the channel ID."
      },
      "onlyBotChannels": {
        "type": "CHECKBOX",
        "required": false,
        "description": "Show only channels the bot is a member of."
      },
      "channel": {
        "type": "DROPDOWN",
        "required": true,
        "description": "Private channels appear only after the bot is added to them."
      },
      "text": {
        "type": "LONG_TEXT",
        "required": false,
        "description": "Slack mrkdwn is supported. Empty sends blocks only."
      },
      "sendAsBot": {
        "type": "CHECKBOX",
        "required": false,
        "description": "Off posts as the connected user and needs a user token."
      },
      "threadTs": {
        "type": "SHORT_TEXT",
        "required": false,
        "description": "Timestamp or link of the parent message to reply under."
      },
      "file": {
        "type": "FILE",
        "required": false,
        "description": "Sent with the message as its comment. Other options are skipped."
      },
      "username": {
        "type": "SHORT_TEXT",
        "required": false,
        "description": "Overrides the bot's display name for this message."
      },
      "profilePicture": {
        "type": "SHORT_TEXT",
        "required": false,
        "description": "Image URL used as the sender's avatar."
      },
      "iconEmoji": {
        "type": "SHORT_TEXT",
        "required": false,
        "description": "Emoji used as the sender's avatar."
      },
      "replyBroadcast": {
        "type": "CHECKBOX",
        "required": false,
        "description": "When replying in a thread, also show the reply in the channel."
      },
      "mentionOriginFlow": {
        "type": "CHECKBOX",
        "required": false,
        "description": "Append a link to this flow at the end of the message."
      },
      "unfurlLinks": {
        "type": "CHECKBOX",
        "required": false,
        "description": "Show link previews in the message."
      },
      "blocks": {
        "type": "JSON",
        "required": false,
        "description": "JSON array of blocks from the Block Kit Builder."
      }
    }
  },
